# Required — Last.fm API key for track.getInfo (Phase 4 metadata + MBIDs)
# and for the dashboard's live scrobble sync (POST /api/lastfm/sync).
# Get one at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# Required for live scrobble sync — your Last.fm username.
LASTFM_USERNAME=your_lastfm_username_here

# Reserved — Discogs personal access token. Not currently wired up.
# The schema has a `discogs_styles` field (always empty for now); this token
# would be needed to populate it with Discogs's richer genre/style taxonomy.
# Leave blank unless you're actively building Discogs enrichment.
DISCOGS_TOKEN=

# Reserved — MusicBrainz User-Agent. Not currently wired up.
# MBIDs are obtained transitively via Last.fm `track.getInfo`, so direct
# MusicBrainz API calls aren't made. Required (by MB's terms of use) only if
# you reactivate direct MB lookups — e.g., for album-level metadata or
# AcousticBrainz integration. Format: "AppName/Version (your@email.com)"
MUSICBRAINZ_USER_AGENT=
