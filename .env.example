# Required — Last.fm API key for track.getInfo (Phase 4 metadata + MBIDs)
# and for the dashboard's live scrobble sync (POST /api/lastfm/sync).
# Get one at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# Required for live scrobble sync — your Last.fm username.
LASTFM_USERNAME=your_lastfm_username_here

# Optional — Discogs personal access token. Used by Phase 4b (enrich_discogs)
# to populate `discogs_styles` with Discogs's richer genre/style taxonomy.
# Phase 4b is an optional pipeline phase; leave blank to skip it (genre
# derivation falls back to Last.fm tags). Currently populated on ~70% of tracks.
DISCOGS_TOKEN=

# Optional — User-Agent string sent on direct Discogs/MusicBrainz API calls
# (used by enrich_discogs and enrich_genre_backfill). Falls back to
# "MusicEnrichment/1.0" if unset. Discogs/MusicBrainz ask for a descriptive UA.
# Format: "AppName/Version (your@email.com)"
MUSICBRAINZ_USER_AGENT=

# Optional — Spotify app credentials for Phase B (enrich_spotify_ids), which
# resolves ISRCs (and incidentally spotify_id) via the Spotify Search API.
# Client-Credentials flow: no user login, just a free app's ID + secret from
# https://developer.spotify.com/dashboard . Alternatively drop a JSON file at
# inputs/spotify_credentials.json with {"client_id": "...", "client_secret": "..."}.
# Absent → Phase B skips gracefully.
# SPOTIFY_CLIENT_SECRET is a real credential — keep it out of version control.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional — shared secret guarding the dashboard's mutating endpoints
# (POST /api/refresh, /api/lastfm/sync, /api/reload). If unset, a random token
# is generated per process (rotates on restart). Set a fixed value to keep it
# stable. The SPA reads it from the same-origin GET /api/config automatically.
DASHBOARD_TOKEN=
